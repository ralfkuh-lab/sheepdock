# Optional. Copy to ~/.config/herdr-kitty/launcher.env to customise the
# environment herdr is started with. This file is sourced by the launcher and
# is never overwritten by install.sh.

# Extra directories for agent CLIs that live outside the usual locations:
# export PATH="$HOME/.grok/bin:$PATH"

# Force a specific editor inside herdr panes:
# export EDITOR=nvim
